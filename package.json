{
  "name": "@constroad/lila-cli",
  "version": "0.5.2",
  "description": "Keystores, builds y publicaci\u00f3n de las apps Android de ConstRoad en LilaStore",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lila": "./bin/lila.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/*.test.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test src/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage src/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/constroad/lila-cli.git"
  },
  "keywords": [
    "android",
    "apk",
    "keystore",
    "lilastore"
  ]
}
